---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const resume = (await getCollection('resume'))[0]?.data;
---

<Layout title="Experience" active="experience" description="Professional experience of Kharisma Rizki Wijanarko in AI evaluation, backend development, and research engineering.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Experience</span>
      <h1 class="page-title">Where I've worked</h1>
      <p class="page-sub">Three roles spanning AI evaluation, backend development, and research engineering.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="exp-list">
        {resume?.experience.map((e) => (
          <article class="exp-block">
            <div class="exp-head">
              <div>
                <h2>{e.company}</h2>
                <p class="exp-role">{e.position}</p>
              </div>
              <div class="exp-meta">
                <span class="exp-duration">{e.startDate} &ndash; {e.endDate}</span>
                <span class="exp-loc">{e.location}</span>
              </div>
            </div>
            <ul class="exp-points">
              {e.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="edu-block">
        <h2 class="sec-title">Education</h2>
        <div class="edu-list">
          {resume?.education.map((ed) => (
            <article class="edu-card">
              <h3>{ed.institution}</h3>
              <p class="edu-degree">{ed.degree}</p>
              <p class="edu-meta">{ed.startDate} &ndash; {ed.endDate} &middot; {ed.location}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="cert-block">
        <h2 class="sec-title">Selected credentials</h2>
        <ul class="cert-list">
          {resume?.certifications.map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <div class="achievement-block">
        <h2 class="sec-title">Achievements</h2>
        <ul class="cert-list">
          {resume?.achievements.map((a) => <li>{a}</li>)}
        </ul>
      </div>

    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding: 72px 0 8px;
  }
  .page-title {
    font-size: clamp(2.2rem, 4.6vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .page-sub {
    color: var(--ink-soft);
    max-width: 56ch;
    margin-top: 12px;
    font-size: 1.05rem;
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 36px;
  }
  .exp-block {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 26px 28px;
    box-shadow: var(--shadow-soft);
  }
  .exp-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .exp-head h2 {
    font-size: 1.35rem;
  }
  .exp-role {
    font-weight: 600;
    color: var(--accent-deep);
    margin: 2px 0 0;
  }
  .exp-meta {
    text-align: right;
  }
  .exp-duration {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .exp-loc {
    font-size: 0.8rem;
    color: var(--ink-faint);
    display: block;
    margin-top: 2px;
  }
  .exp-points {
    padding-left: 20px;
    color: var(--ink-soft);
  }
  .exp-points li {
    margin-bottom: 8px;
  }

  .edu-block,
  .cert-block,
  .achievement-block {
    margin-top: 64px;
  }
  .edu-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
  }
  .edu-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-soft);
  }
  .edu-card h3 {
    font-size: 1.1rem;
  }
  .edu-degree {
    font-weight: 600;
    color: var(--accent-deep);
    margin: 4px 0 0;
    font-size: 0.95rem;
  }
  .edu-meta {
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin: 4px 0 12px;
  }
  .edu-card ul {
    padding-left: 18px;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .cert-list {
    margin-top: 24px;
    padding-left: 20px;
    color: var(--ink-soft);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 24px;
  }
  .cert-list li {
    margin-bottom: 4px;
  }
  .center-link {
    text-align: center;
    margin-top: 56px;
  }

  @media (max-width: 768px) {
    .exp-meta {
      text-align: left;
    }
    .edu-list,
    .cert-list {
      grid-template-columns: 1fr;
    }
  }
</style>
