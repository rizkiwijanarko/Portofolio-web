---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const resume = (await getCollection('resume'))[0]?.data;
const projects = await getCollection('projects');
const pdf = import.meta.env.BASE_URL + 'Kharisma_Rizki_Wijanarko_CV.pdf';
---

<Layout title="Résumé" active="resume" description="Résumé of Kharisma Rizki Wijanarko — AI Engineer.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Résumé</span>
      <h1 class="page-title">Résumé</h1>
      <p class="page-sub">A concise hiring snapshot of selected experience, projects, skills, education, and credentials.</p>
      <div class="head-actions"><a class="btn btn-primary" href={pdf} download>Download résumé</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <article class="resume-content">
        <p class="resume-headline">AI Engineer | End-to-End AI Product Engineering</p>
        <p class="resume-summary">{resume?.summary}</p>
        <section class="resume-section">
          <h2>Selected experience</h2>
          {resume?.experience.map((e) => (
            <article class="resume-entry">
              <div><h3>{e.company}</h3><p class="resume-role">{e.position} · {e.location}</p></div>
              <span class="resume-date">{e.startDate} – {e.endDate}</span>
              <ul>{e.highlights.slice(0, 2).map((h) => <li>{h}</li>)}</ul>
            </article>
          ))}
        </section>
        <section class="resume-section">
          <h2>Selected projects</h2>
          {['ningsih-app', 'ventureforge', 'orla', 'rizclone'].map((id) => {
            const project = projects.find((p) => p.id === id);
            const resumeProject = resume?.projects.find((p) => p.caseStudyId === id);
            return project && resumeProject ? (
              <article class="resume-entry">
                <div><h3><a href={import.meta.env.BASE_URL + 'projects/' + project.id + '/'}>{project.data.title.split(':')[0]}</a></h3><p class="resume-role">{project.data.context} · {project.data.maturity}</p></div>
                <p>{project.data.summary}</p>
              </article>
            ) : null;
          })}
        </section>
        <section class="resume-section resume-columns">
          <div><h2>Skills</h2>{resume?.skills.map((s) => <p><strong>{s.label}:</strong> {s.details.join(', ')}</p>)}</div>
          <div><h2>Education</h2>{resume?.education.map((e) => <p><strong>{e.institution}</strong><br />{e.degree} · {e.startDate} – {e.endDate}</p>)}</div>
        </section>
        <section class="resume-section"><h2>Relevant certifications</h2><ul>{resume?.certifications.slice(0, 3).map((c) => <li>{c}</li>)}</ul></section>
      </article>

      <div class="resume-links">
        <span class="eyebrow">Also on</span>
        <div class="link-row">
          <a class="btn btn-soft" href={resume?.contact.github} target="_blank" rel="noopener">GitHub</a>
          <a class="btn btn-soft" href={resume?.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn btn-soft" href={'mailto:' + resume?.contact.email}>Email</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding: 72px 0 8px;
  }
  .page-title {
    font-size: clamp(2.2rem, 4.6vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .page-sub {
    color: var(--ink-soft);
    max-width: 56ch;
    margin-top: 12px;
    font-size: 1.05rem;
  }
  .head-actions {
    margin-top: 24px;
  }
  .resume-content {
    max-width: 820px;
    margin: 36px auto 0;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 32px;
  }
  .resume-headline {
    color: var(--accent-deep);
    font-weight: 750;
    font-size: 1.15rem;
  }
  .resume-summary {
    color: var(--ink-soft);
    max-width: 70ch;
    margin-top: 8px;
  }
  .resume-section {
    border-top: 1px solid var(--hairline);
    margin-top: 28px;
    padding-top: 24px;
  }
  .resume-section h2 {
    font-size: 1.3rem;
    margin-bottom: 16px;
  }
  .resume-entry {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 20px;
    padding: 16px 0;
    border-top: 1px solid var(--hairline);
  }
  .resume-entry:first-of-type {
    border-top: none;
  }
  .resume-entry h3 {
    font-size: 1rem;
  }
  .resume-entry p,
  .resume-entry li {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .resume-role {
    color: var(--accent-deep) !important;
    margin-top: 3px;
  }
  .resume-date {
    color: var(--ink-faint);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .resume-entry ul {
    grid-column: 1 / -1;
    padding-left: 20px;
  }
  .resume-entry > p {
    grid-column: 1 / -1;
    margin: 0;
  }
  .resume-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .resume-columns p {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin-top: 8px;
  }
  .resume-links {
    margin-top: 48px;
    text-align: center;
  }
  .link-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }
  @media (max-width: 768px) {
    .resume-content {
      padding: 24px 20px;
    }
    .resume-entry,
    .resume-columns {
      grid-template-columns: 1fr;
    }
    .resume-date {
      grid-row: 1;
    }
    .resume-entry ul,
    .resume-entry > p {
      grid-column: auto;
    }
  }
</style>
