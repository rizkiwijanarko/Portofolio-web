---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const resume = (await getCollection('resume'))[0]?.data;
const projects = await getCollection('projects');
const pdf = import.meta.env.BASE_URL + 'Kharisma_Rizki_Wijanarko_CV.pdf';
const resumeProjectIds = ['ningsih-app', 'signalatlas', 'ventureforge', 'wayang-classification'];
const formatMonth = (value?: string) => {
  if (!value || value === 'Present') return value ?? '';
  const [year, month] = value.split('-');
  if (!month) return value;
  return new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(new Date(Number(year), Number(month) - 1));
};
const formatRange = (start?: string, end?: string) => [formatMonth(start), formatMonth(end)].filter(Boolean).join(' – ');
---

<Layout title="Résumé" active="resume" description="Résumé of Kharisma Rizki Wijanarko — AI Engineer.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Résumé</span>
      <h1 class="page-title">Résumé</h1>
      <p class="page-sub">A concise hiring snapshot of selected experience, projects, skills, education, and credentials.</p>
      <div class="head-actions"><a class="btn btn-primary" href={pdf} download>Download résumé</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <article class="resume-content">
        <p class="resume-headline">AI Engineer · Applied AI, Machine Learning Systems, and LLM Engineering</p>
        <p class="resume-summary">{resume?.summary}</p>
        <div class="resume-contact" aria-label="Contact details">
          {resume?.contact.email && <a href={'mailto:' + resume.contact.email}>{resume.contact.email}</a>}
          {resume?.contact.phone && <a href={'tel:' + resume.contact.phone}>{resume.contact.phone}</a>}
          <span>{resume?.contact.location}</span>
        </div>
        <section class="resume-section">
          <h2>Work experience</h2>
          {resume?.experience.map((e) => (
            <article class="resume-entry">
              <div><h3>{e.company}</h3><p class="resume-role">{e.position} · {e.location}</p></div>
              <span class="resume-date">{formatRange(e.startDate, e.endDate)}</span>
              <ul>{e.highlights.map((h) => <li>{h}</li>)}</ul>
            </article>
          ))}
        </section>
        <section class="resume-section">
          <h2>Projects</h2>
          {resumeProjectIds.map((id) => {
            const project = projects.find((p) => p.id === id);
            const resumeProject = resume?.projects.find((p) => p.caseStudyId === id);
            return project && resumeProject ? (
              <article class="resume-entry">
                <div>
                  <h3><a class="resume-project-link" href={import.meta.env.BASE_URL + 'projects/' + project.id + '/'}>{resumeProject.name}</a></h3>
                  <p class="resume-role">{resumeProject.tech.join(', ')}</p>
                  {resumeProject.repoUrl && <a class="resume-inline-link" href={resumeProject.repoUrl} target="_blank" rel="noopener" aria-label={`${resumeProject.name} source code (opens in a new tab)`}>GitHub</a>}
                </div>
                <span class="resume-date">{formatRange(resumeProject.startDate, resumeProject.endDate)}</span>
                <ul>{resumeProject.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
              </article>
            ) : null;
          })}
        </section>
        <section class="resume-section resume-columns">
          <div><h2>Skills</h2>{resume?.skills.map((s) => <p><strong>{s.label}:</strong> {s.details.join(', ')}</p>)}</div>
          <div>
            <h2>Education</h2>
            {resume?.education.map((e) => (
              <div class="education-entry">
                <p><strong>{e.institution}</strong></p>
                <p>{e.degree} · {e.location}</p>
                <p class="resume-date">{formatRange(e.startDate, e.endDate)}</p>
                {e.highlights.map((highlight) => <p>{highlight}</p>)}
              </div>
            ))}
          </div>
        </section>
        <section class="resume-section"><h2>Certifications</h2><ul>{resume?.certifications.map((c) => <li>{c}</li>)}</ul></section>
        <section class="resume-section"><h2>Achievements</h2><ul>{resume?.achievements.map((a) => <li>{a}</li>)}</ul></section>
      </article>

      <div class="resume-links">
        <span class="eyebrow">Also on</span>
        <div class="link-row">
          <a class="btn btn-soft" href={resume?.contact.github} target="_blank" rel="noopener" aria-label="GitHub profile (opens in a new tab)">GitHub</a>
          <a class="btn btn-soft" href={resume?.contact.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn profile (opens in a new tab)">LinkedIn</a>
          <a class="btn btn-soft" href={'mailto:' + resume?.contact.email}>Email</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding: 72px 0 8px;
  }
  .page-title {
    font-size: clamp(2.2rem, 4.6vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .page-sub {
    color: var(--ink-soft);
    max-width: 56ch;
    margin-top: 12px;
    font-size: 1.05rem;
  }
  .head-actions {
    margin-top: 24px;
  }
  .resume-content {
    max-width: 820px;
    margin: 36px auto 0;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 32px;
  }
  .resume-headline {
    color: var(--accent-deep);
    font-weight: 750;
    font-size: 1.15rem;
  }
  .resume-summary {
    color: var(--ink-soft);
    max-width: 70ch;
    margin-top: 8px;
  }
  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 18px;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .resume-contact a {
    color: var(--accent-deep);
  }
  .resume-section {
    border-top: 1px solid var(--hairline);
    margin-top: 28px;
    padding-top: 24px;
  }
  .resume-section h2 {
    font-size: 1.3rem;
    margin-bottom: 16px;
  }
  .resume-entry {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 20px;
    padding: 16px 0;
    border-top: 1px solid var(--hairline);
  }
  .resume-entry:first-of-type {
    border-top: none;
  }
  .resume-entry h3 {
    font-size: 1rem;
  }
  .resume-project-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .resume-inline-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--accent-deep);
    font-size: 0.82rem;
    font-weight: 650;
  }
  .resume-entry p,
  .resume-entry li {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .resume-role {
    color: var(--accent-deep) !important;
    margin-top: 3px;
  }
  .resume-date {
    color: var(--ink-faint);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .resume-entry ul {
    grid-column: 1 / -1;
    padding-left: 20px;
  }
  .resume-entry > p {
    grid-column: 1 / -1;
    margin: 0;
  }
  .resume-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .resume-columns p {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin-top: 8px;
  }
  .education-entry + .education-entry {
    margin-top: 18px;
  }
  .resume-links {
    margin-top: 48px;
    text-align: center;
  }
  .link-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }
  @media (max-width: 768px) {
    .resume-content {
      padding: 24px 20px;
    }
    .resume-entry,
    .resume-columns {
      grid-template-columns: 1fr;
    }
    .resume-date {
      grid-row: auto;
    }
    .resume-entry ul,
    .resume-entry > p {
      grid-column: auto;
    }
  }
</style>
