---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const resume = (await getCollection('resume'))[0]?.data;
const base = import.meta.env.BASE_URL;
const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const caseStudyOrder = ['ningsih-app', 'ventureforge', 'orla', 'rizclone'];
const caseStudies = allProjects.filter((p) => p.data.featured).sort((a, b) => caseStudyOrder.indexOf(a.id) - caseStudyOrder.indexOf(b.id));
const otherProjects = [
  ...allProjects
    .filter((p) => ['signalatlas', 'wayang-classification'].includes(p.id))
    .map((p) => ({
      id: p.id,
      name: p.data.title,
      summary: p.data.summary,
      category: p.data.category,
      context: p.data.context,
      status: p.data.status,
      maturity: p.data.maturity,
      startDate: p.data.startDate,
      caseStudyId: p.id,
      repoUrl: p.data.repoUrl,
      demoUrl: p.data.demoUrl,
    })),
  ...(resume?.projects ?? []).filter((p) => ['Sustainable Urbanization Clustering Analysis', 'Lapor Pak'].includes(p.name)),
];

const getAvailability = (project: { caseStudyId?: string; demoUrl?: string; repoUrl?: string; status?: string }) => {
  if (project.caseStudyId) return { label: 'Read case study', href: base + 'projects/' + project.caseStudyId + '/' };
  if (project.demoUrl) return { label: 'Live demo', href: project.demoUrl, external: true };
  if (project.repoUrl) return { label: 'View source', href: project.repoUrl, external: true };
  if (project.status === 'building') return { label: 'Private build' };
  return { label: 'No public link' };
};

const formatDate = (value?: string) => {
  if (!value) return '';
  const [year, month] = value.split('-');
  if (!month) return year;
  return new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(new Date(Number(year), Number(month) - 1));
};
---

<Layout title="Projects" active="projects" description="Selected projects by Kharisma Rizki Wijanarko, including AI products, client delivery, and applied machine learning.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Projects</span>
      <h1 class="page-title">Selected projects</h1>
      <p class="page-sub">A focused set of AI products, client delivery, and applied machine-learning work. Each project is labeled by its current status and available evidence.</p>
    </div>
  </section>

  <!-- Featured case studies -->
  <section class="section">
    <div class="wrap">
      <h2 class="sec-title">Selected case studies</h2>
      <div class="featured-list">
        {caseStudies.map((p) => {
          const availability = getAvailability(p.data);
          return (
          <article class="case-card">
            <a href={base + 'projects/' + p.id + '/'} class="case-link" aria-label={'Read the ' + p.data.title + ' case study'}>
              <div class="preview-panel">
                {p.data.previewAvailable && p.data.preview ? (
                  <img class="preview-img" src={base + p.data.preview.replace(/^\//, '')} alt={p.data.title + ' preview'} width="800" height="500" loading="lazy" />
                ) : (
                  <span>Preview coming soon</span>
                )}
              </div>
              <div class="case-body">
                <div class="case-top">
                  <h3>{p.data.title}</h3>
                  <span class:list={['status-pill', 'status-' + p.data.status]}>{p.data.maturity ?? p.data.status}</span>
                </div>
                <p class="case-category">{p.data.context} &middot; {p.data.category} &middot; {p.data.role} &middot; {formatDate(p.data.startDate)}</p>
                <p class="case-proof">{p.data.summary}</p>
                <div class="case-actions">
                  <span class="case-cta">Read case study &rarr;</span>
                  <span class="availability">{availability.label}</span>
                </div>
              </div>
            </a>
          </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Card-only projects -->
  <section class="section">
    <div class="wrap">
      <h2 class="sec-title">More work</h2>
      <p class="sec-sub">A compact archive of earlier products, research, and experiments.</p>
      <div class="archive-list">
        {otherProjects.map((p) => {
          const availability = getAvailability(p);
          const details = `${p.context ? p.context + ' · ' : ''}${p.category ?? 'Project'} · ${formatDate(p.startDate ?? p.date)}`;
          return (
            <article class="archive-item">
              {availability.href ? (
                  <a href={availability.href} target={availability.external ? '_blank' : undefined} rel={availability.external ? 'noopener' : undefined} class="archive-link" aria-label={`${p.name} — ${availability.label}${availability.external ? ', opens in a new tab' : ''}`}>
                  <span class="archive-name">{p.name}</span>
                  <span class="archive-details">{details}</span>
                  {p.status && <span class:list={['status-pill', 'status-' + p.status]}>{p.maturity ?? p.status}</span>}
                  <span class="archive-action">{availability.label} &rarr;</span>
                </a>
              ) : (
                <div class="archive-link">
                  <span class="archive-name">{p.name}</span>
                  <span class="archive-details">{details}</span>
                  {p.status && <span class:list={['status-pill', 'status-' + p.status]}>{p.maturity ?? p.status}</span>}
                  <span class="archive-action archive-action-muted">{availability.label}</span>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding: 72px 0 8px;
  }
  .page-title {
    font-size: clamp(2.2rem, 4.6vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .page-sub {
    color: var(--ink-soft);
    max-width: 56ch;
    margin-top: 12px;
    font-size: 1.05rem;
  }

  .featured-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 36px;
  }
  .case-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .case-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .case-link {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    color: inherit;
  }
  .case-link:hover {
    text-decoration: none;
  }
  .case-link .preview-panel {
    min-width: 0;
    aspect-ratio: 16 / 10;
    align-self: stretch;
    padding: 18px;
    border-radius: 0;
    border: none;
    border-right: 1.5px dashed #d9c3a8;
  }
  .case-link .preview-panel .preview-img {
    object-fit: contain;
  }
  .case-body {
    padding: 24px 26px;
  }
  .case-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .case-top h3 {
    min-width: 0;
    font-size: 1.25rem;
  }
  .case-category {
    color: var(--ink-faint);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 4px 0 0;
  }
  .case-proof {
    color: var(--accent-deep);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 16px 0 8px;
  }
  .case-summary {
    color: var(--ink-soft);
    margin: 8px 0 12px;
  }
  .case-actions {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 10px;
  }
  .case-cta {
    font-weight: 650;
    color: var(--accent-deep);
  }
  .availability {
    color: var(--ink-faint);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .archive-list {
    margin-top: 28px;
    border-top: 1px solid var(--hairline);
  }
  .archive-item {
    border-bottom: 1px solid var(--hairline);
  }
  .archive-link {
    display: grid;
    grid-template-columns: minmax(220px, 1.5fr) minmax(150px, 1fr) auto minmax(130px, auto);
    align-items: center;
    gap: 16px;
    padding: 16px 4px;
    color: inherit;
  }
  .archive-link:hover {
    text-decoration: none;
    background: rgba(255, 255, 255, 0.45);
  }
  .archive-link > * {
    min-width: 0;
  }
  .archive-name {
    font-weight: 700;
  }
  .archive-details {
    color: var(--ink-faint);
    font-size: 0.86rem;
    font-weight: 600;
  }
  .archive-action {
    color: var(--accent-deep);
    font-size: 0.86rem;
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }
  .archive-action-muted {
    color: var(--ink-faint);
  }

  @media (max-width: 768px) {
    .case-link {
      grid-template-columns: 1fr;
    }
    .case-link .preview-panel {
      border-right: none;
      border-bottom: 1.5px dashed #d9c3a8;
      border-radius: 0;
    }
    .archive-link {
      grid-template-columns: 1fr auto;
      gap: 6px 12px;
      padding: 14px 4px;
    }
    .archive-name {
      grid-column: 1 / -1;
    }
    .archive-details {
      grid-column: 1;
    }
    .archive-link .status-pill {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
    }
    .archive-action {
      grid-column: 1 / -1;
      text-align: left;
    }
  }
</style>
