---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
---

<Layout title={project.data.title} active="projects" description={project.data.summary} image={project.data.preview}>
  <article class="case-study">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={base + 'projects/'}>Projects</a> <span aria-hidden="true">&rarr;</span> <span class="current">{project.data.title}</span>
      </nav>

      <header class="cs-head">
        <div class="cs-meta">
          <span class:list={['status-pill', 'status-' + project.data.status]}>{project.data.status}</span>
          <span class="cs-category">{project.data.category} &middot; {project.data.role} &middot; {project.data.startDate}</span>
        </div>
        <h1 class="cs-title">{project.data.title}</h1>
        <p class="cs-summary">{project.data.summary}</p>
        <div class="cs-tech">{project.data.tech.map((t) => <span class="chip">{t}</span>)}</div>
        <div class="cs-actions">
          {project.data.repoUrl && (
            <a class="btn btn-soft" href={project.data.repoUrl} target="_blank" rel="noopener">View source on GitHub &rarr;</a>
          )}
          {project.data.demoUrl && (
            <a class="btn btn-primary" href={project.data.demoUrl} target="_blank" rel="noopener">Try the demo &rarr;</a>
          )}
          <a class="btn btn-soft" href={base + 'projects/'}>All projects</a>
        </div>
      </header>

      <div class="preview-panel cs-preview">
        {project.data.previewAvailable && project.data.preview ? (
          <img class="preview-img" src={base + project.data.preview.replace(/^\//, '')} alt={project.data.title + ' preview'} width="800" height="500" fetchpriority="high" />
        ) : (
          <span>Product preview coming soon</span>
        )}
      </div>

      <div class="cs-body">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .case-study {
    padding: 56px 0 40px;
  }
  .crumbs {
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin-bottom: 32px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .crumbs a {
    color: var(--accent-deep);
    font-weight: 600;
  }
  .crumbs .current {
    color: var(--ink-soft);
  }
  .cs-head {
    max-width: 760px;
  }
  .cs-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cs-category {
    color: var(--ink-faint);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .cs-title {
    font-size: clamp(2rem, 4.4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-top: 14px;
  }
  .cs-summary {
    color: var(--ink-soft);
    font-size: 1.1rem;
    margin: 14px 0 0;
    max-width: 60ch;
  }
  .cs-tech {
    margin-top: 16px;
  }
  .cs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .cs-preview {
    margin: 40px 0;
    aspect-ratio: 16 / 7;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #f3ece1, #ead9c8);
    border: 1.5px dashed #d9c3a8;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-faint);
    font-weight: 600;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
  }
  .cs-body {
    max-width: 780px;
  }
  .cs-body :global(h2) {
    font-size: 1.55rem;
    margin: 48px 0 14px;
    letter-spacing: -0.02em;
  }
  .cs-body :global(h2:first-child) {
    margin-top: 8px;
  }
  .cs-body :global(h3) {
    font-size: 1.2rem;
    margin: 28px 0 10px;
    letter-spacing: -0.01em;
  }
  .cs-body :global(p) {
    color: var(--ink-soft);
    margin-bottom: 1em;
    line-height: 1.7;
  }
  .cs-body :global(ul), .cs-body :global(ol) {
    padding-left: 22px;
    margin-bottom: 1.2em;
    color: var(--ink-soft);
  }
  .cs-body :global(li) {
    margin-bottom: 8px;
    line-height: 1.65;
  }
  .cs-body :global(li strong) {
    color: var(--ink);
  }
  .cs-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--chip-bg);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--accent-deep);
  }
  .cs-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 12px 18px;
    background: var(--accent-tint);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink);
    font-style: normal;
    margin: 24px 0;
  }

  /* Table styling */
  .cs-body :global(table) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 28px 0;
    font-size: 0.9rem;
    background: var(--card);
    border-radius: var(--radius-md);
    border: 1px solid var(--card-border);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .cs-body :global(th) {
    text-align: left;
    padding: 12px 16px;
    background: var(--chip-bg);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--card-border);
  }
  .cs-body :global(td) {
    padding: 14px 16px;
    border-bottom: 1px solid var(--hairline);
    color: var(--ink-soft);
    vertical-align: top;
    line-height: 1.55;
  }
  .cs-body :global(tr:last-child td) {
    border-bottom: none;
  }

  /* Figure cards for architecture / diagrams */
  .cs-body :global(.figure-card) {
    margin: 32px 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--card-border);
    background: var(--card);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  .cs-body :global(.figure-card img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .cs-body :global(.figure-caption) {
    padding: 10px 18px;
    font-size: 0.84rem;
    color: var(--ink-faint);
    background: #fdfbf7;
    border-top: 1px solid var(--hairline);
  }

  /* Inlined Feature Cards */
  .cs-body :global(.feature-card) {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 28px;
    align-items: center;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin: 28px 0;
    box-shadow: var(--shadow-soft);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .cs-body :global(.feature-card:hover) {
    box-shadow: var(--shadow-card);
  }
  .cs-body :global(.feature-media) {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .cs-body :global(.feature-media img) {
    width: 100%;
    max-width: 220px;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--card-border);
    box-shadow: 0 6px 20px rgba(90, 65, 40, 0.08);
    display: block;
  }
  .cs-body :global(.feature-content) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cs-body :global(.feature-content h3) {
    margin: 0;
    font-size: 1.25rem;
    color: var(--ink);
  }
  .cs-body :global(.feature-pain) {
    font-size: 0.88rem;
    color: var(--accent-deep);
    font-weight: 600;
    background: var(--accent-tint);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    display: inline-block;
    width: fit-content;
    margin-bottom: 2px;
  }
  .cs-body :global(.feature-desc) {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
  .cs-body :global(.feature-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .cs-body :global(.chip-sm) {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--chip-bg);
    border-radius: var(--radius-pill);
    padding: 3px 9px;
  }

  /* Legacy Screen gallery for projects without inlining */
  .cs-body :global(.screen-gallery) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin: 28px -40px 0;
  }
  .cs-body :global(.screen-gallery img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    background: var(--card);
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 768px) {
    .cs-body :global(.feature-card) {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 20px;
    }
    .cs-body :global(.feature-media img) {
      max-width: 200px;
      margin-inline: auto;
    }
    .cs-body :global(.screen-gallery) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-inline: 0;
      gap: 20px;
    }
  }

  @media (max-width: 520px) {
    .cs-body :global(.screen-gallery) {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
