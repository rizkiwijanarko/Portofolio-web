---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const resume = (await getCollection('resume'))[0]?.data;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).sort((a, b) => {
  const order = ['ningsih-app', 'ventureforge', 'orla', 'rizclone'];
  return order.indexOf(a.id) - order.indexOf(b.id);
});
const relevantExperience = resume?.experience.filter((e) => ['Outlier.AI', 'BIT & PARI'].includes(e.company)) ?? [];
const freelanceClientProject = resume?.projects.find((p) => p.caseStudyId === 'orla');

const base = import.meta.env.BASE_URL;
const photo = base + 'assets/my_photo.jpg';
const pdf = base + 'Kharisma_Rizki_Wijanarko_CV.pdf';
---

<Layout title="Home" active="home" description="Kharisma Rizki Wijanarko — AI Engineer helping founders turn unclear ideas and workflows into useful AI-powered products.">
  <!-- ============ Hero ============ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-inner">
        <div class="hero-avatar">
          <img src={photo} alt="Portrait of Kharisma Rizki Wijanarko" width="816" height="1118" />
        </div>
        <div class="hero-copy">
          <div class="avail"><span class="dot" aria-hidden="true"></span> Available for selected projects and AI Engineer roles</div>
          <h1>{resume?.contact.name}</h1>
          <p class="title"><em>AI Engineer</em><span class="title-detail"> · End-to-end AI product engineering</span></p>
          <p class="statement">I help founders turn unclear product ideas and workflows into useful AI-powered web or mobile products.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={pdf} download>Download résumé</a>
            <a class="btn btn-round btn-soft" href={resume?.contact.github} target="_blank" rel="noopener" aria-label="GitHub profile (opens in a new tab)">
              <svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
            <a class="btn btn-round btn-soft" href={resume?.contact.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn profile (opens in a new tab)">
              <svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a class="btn btn-round btn-soft" href={'mailto:' + resume?.contact.email} aria-label="Send an email">
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m3 7 9 6 9-6"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Selected work ============ -->
  <section class="section" id="projects">
    <div class="wrap">
      <span class="eyebrow">Selected work</span>
      <h2 class="sec-title">Useful products, thoughtfully built</h2>
      <p class="sec-sub">A few projects that show how I turn messy problems into working products and systems.</p>
      {featured[0] && (
        <article class="flagship-card">
          <a href={base + 'projects/' + featured[0].id + '/'} class="card-link" aria-label={'Read the ' + featured[0].data.context + ' case study for ' + featured[0].data.title}>
            <div class="flagship-media preview-panel">
              <img class="preview-img" src={base + featured[0].data.preview.replace(/^\//, '')} alt={featured[0].data.title + ' app preview'} width="800" height="500" fetchpriority="high" />
            </div>
            <div class="flagship-body">
              <span class="eyebrow">Current focus</span>
              <div class="card-top"><h3>{featured[0].data.title.split(':')[0]}</h3><span class:list={['status-pill', 'status-' + featured[0].data.status]}>{featured[0].data.maturity}</span></div>
              <p class="card-context">{featured[0].data.context}</p>
              <p class="flagship-summary">{featured[0].data.summary}</p>
              <p class="flagship-next">Next step: {featured[0].data.nextStep ?? 'Continue testing and documenting the product.'}</p>
              <span class="card-cta">Read the case study &rarr;</span>
            </div>
          </a>
        </article>
      )}
      <div class="supporting-grid">
        {featured.slice(1).map((p) => (
          <article class="product-card">
            <a href={base + 'projects/' + p.id + '/'} class="card-link" aria-label={'Read the ' + p.data.context + ' case study for ' + p.data.title}>
              <div class="preview-panel">
                {p.data.previewAvailable && p.data.preview ? (
                  <img class="preview-img" src={base + p.data.preview.replace(/^\//, '')} alt={p.data.title + ' preview'} width="800" height="500" loading="lazy" />
                ) : <span>Preview coming soon</span>}
              </div>
              <div class="card-body">
                <div class="card-top"><h3>{p.data.title.split(':')[0]}</h3><span class:list={['status-pill', 'status-' + p.data.status]}>{p.data.maturity}</span></div>
                <p class="card-context">{p.data.context}</p>
                <p class="card-summary">{p.data.summary}</p>
                <span class="card-cta">Read the case study &rarr;</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Services ============ -->
  <section class="section" id="services">
    <div class="wrap">
      <span class="eyebrow">How I can help</span>
      <h2 class="sec-title">From product idea to a useful working product</h2>
      <p class="sec-sub">I help founders and small businesses turn an AI product idea or workflow into a useful working product.</p>
      <div class="service-grid">
        <article class="service-card"><h3>AI product development</h3><p>Shape and build an AI product from the first useful workflow to a working web or mobile application.</p></article>
        <article class="service-card"><h3>AI systems and integrations</h3><p>Connect models, data, APIs, and product interfaces so AI supports a real user workflow.</p></article>
        <article class="service-card"><h3>Workflow automation</h3><p>Reduce repetitive work with dependable backend processes, data pipelines, and business integrations.</p></article>
      </div>
      <div class="center-link"><a class="btn btn-primary" href={base + '#contact'}>Describe your product or workflow &rarr;</a></div>
    </div>
  </section>

  <!-- ============ Professional impact ============ -->
  <section class="section" id="impact">
    <div class="wrap">
      <span class="eyebrow">Professional impact</span>
      <h2 class="sec-title">Engineering that improves the workflow</h2>
      <div class="impact-list">
        {relevantExperience.map((e) => (
          <article class="impact-card">
            <div><h3>{e.company}</h3><p class="impact-role">{e.position} · {e.location}</p></div>
            <ul class="impact-points">{e.highlights.slice(0, 2).map((highlight) => <li>{highlight}</li>)}</ul>
          </article>
        ))}
        {freelanceClientProject && (
          <article class="impact-card">
            <div><h3>Freelance Full-stack Developer — Orla.co</h3><p class="impact-role">Paid client project · E-commerce product delivery</p></div>
            <ul class="impact-points">{freelanceClientProject.highlights.slice(0, 2).map((highlight) => <li>{highlight}</li>)}</ul>
          </article>
        )}
      </div>
    </div>
  </section>

  <!-- ============ Contact ============ -->
  <section class="section" id="contact">
    <div class="wrap">
      <div class="contact-card">
        <span class="eyebrow">Contact</span>
        <h2 class="sec-title">Let's talk about your product.</h2>
        <p class="sec-sub">I'm open to freelance product work and AI Engineer roles.</p>
        <div class="contact-actions">
          <a class="btn btn-primary" href={'mailto:' + resume?.contact.email + '?subject=Product%20or%20workflow%20inquiry'}>Describe your product or workflow</a>
          <a class="btn btn-round btn-soft" href={resume?.contact.github} target="_blank" rel="noopener" aria-label="GitHub profile (opens in a new tab)">
            <svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a class="btn btn-round btn-soft" href={resume?.contact.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn profile (opens in a new tab)">
            <svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
        <p class="contact-meta">{resume?.contact.location} &middot; WIB (UTC+7)</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============ Hero ============ */
  .hero {
    padding: 64px 0 48px;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 44px;
    align-items: center;
    max-width: 880px;
    margin-inline: auto;
  }
  .hero-avatar {
    margin: 0;
    width: 200px;
    position: relative;
    flex: none;
  }
  .hero-avatar::before {
    content: '';
    position: absolute;
    inset: -10px;
    z-index: -1;
    border: 2px dashed var(--preview-border);
    border-radius: 30px;
    transform: rotate(-2deg);
  }
  .hero-avatar img {
    width: 200px;
    height: auto;
    display: block;
    border-radius: 22px;
    border: 4px solid var(--on-accent);
    box-shadow: var(--shadow-card);
  }
  .hero-copy {
    text-align: left;
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-pill);
    padding: 7px 14px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
    box-shadow: var(--shadow-soft);
    margin-bottom: 16px;
  }
  .avail .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-tint);
  }
  .hero h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .hero .title {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    font-weight: 600;
    color: var(--ink-soft);
    margin: 10px 0 0;
    max-width: 46ch;
  }
  .hero .title em {
    font-style: normal;
    color: var(--accent-deep);
  }
  .hero .statement {
    max-width: 52ch;
    margin: 14px 0 0;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }
  .hero-actions {
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  /* ============ Featured products ============ */
  .flagship-card {
    margin-top: 36px;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .flagship-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .flagship-card .card-link {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
  }
  .flagship-media {
    min-height: 340px;
    border-radius: 0;
    border: none;
    border-right: 1.5px dashed var(--preview-border);
  }
  .flagship-body {
    padding: 30px;
  }
  .flagship-body .eyebrow {
    margin-bottom: 18px;
  }
  .flagship-summary {
    color: var(--ink);
    font-size: 1.25rem;
    line-height: 1.4;
    margin: 18px 0 10px;
  }
  .flagship-next {
    color: var(--ink-soft);
    font-size: 0.94rem;
    margin: 0;
  }
  .supporting-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
  }
  .product-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }
  .card-link {
    display: block;
    color: inherit;
    height: 100%;
  }
  .card-link:hover {
    text-decoration: none;
  }
  .card-body {
    padding: 20px 22px 22px;
  }
  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }
  .card-top h3 {
    font-size: 1.15rem;
  }
  .card-summary {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 8px 0 10px;
  }
  .title-detail {
    color: var(--ink-soft);
  }
  .card-tech {
    margin-top: 4px;
  }
  .card-cta {
    display: inline-block;
    margin-top: 8px;
    font-weight: 650;
    font-size: 0.92rem;
    color: var(--accent-deep);
  }

  .card-context {
    color: var(--accent-deep);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 6px 0 0;
  }
  .card-evidence {
    margin-top: 8px;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  .service-card,
  .impact-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 24px;
  }
  .service-card h3,
  .impact-card h3 {
    font-size: 1.08rem;
  }
  .service-card p,
  .impact-card p {
    color: var(--ink-soft);
    margin: 8px 0 0;
    font-size: 0.94rem;
  }
  .impact-card {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 1.2fr;
    gap: 24px;
    margin-top: 0;
  }
  .impact-list {
    display: grid;
    gap: 14px;
    margin-top: 32px;
  }
  .impact-role {
    color: var(--ink-faint) !important;
    font-size: 0.82rem !important;
  }
  .impact-points {
    padding-left: 20px;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }
  .impact-points li {
    margin-bottom: 6px;
  }

  /* ============ Journey timeline ============ */
  .tl {
    position: relative;
    max-width: 760px;
    margin: 46px auto 0;
    padding-left: 72px;
  }
  .tl::before {
    content: '';
    position: absolute;
    left: 24px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--hairline);
  }
  .tl-item {
    position: relative;
    margin-bottom: 20px;
  }
  .tl-item:last-child {
    margin-bottom: 0;
  }
  .tl-node {
    position: absolute;
    left: -72px;
    top: 16px;
    display: flex;
    justify-content: center;
    width: 72px;
  }
  .tl-dot {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--accent);
    color: var(--accent-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 750;
    font-family: var(--font-mono);
    box-shadow: var(--shadow-soft);
  }
  .tl-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 18px 22px;
    box-shadow: var(--shadow-soft);
  }
  .tl-card h3 {
    font-size: 1.06rem;
    font-weight: 700;
  }
  .tl-card p {
    margin: 4px 0 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .tl-now {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--accent-tint);
    color: var(--accent-deep);
    border-radius: var(--radius-pill);
    padding: 3px 9px;
    margin-left: 8px;
    vertical-align: 2px;
  }
  .tl-item.current .tl-dot {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .tl-item.current .tl-card {
    background: linear-gradient(180deg, var(--surface-soft), var(--card));
    border-color: var(--surface-soft-border);
  }

  /* ============ Experience ============ */
  .exp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
    margin-top: 36px;
  }
  .exp-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    padding: 22px;
    box-shadow: var(--shadow-soft);
  }
  .exp-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .exp-head h3 {
    font-size: 1.05rem;
  }
  .exp-duration {
    font-size: 0.75rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .exp-role {
    font-weight: 600;
    color: var(--accent-deep);
    margin: 4px 0 0;
    font-size: 0.92rem;
  }
  .exp-loc {
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin: 2px 0 10px;
  }
  .exp-points {
    padding-left: 18px;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .exp-points li {
    margin-bottom: 6px;
  }
  .center-link {
    text-align: center;
    margin-top: 32px;
  }

  /* ============ Contact ============ */
  .contact-card {
    max-width: 760px;
    margin: 88px auto 0;
    text-align: center;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    padding: 56px 40px 48px;
    border: 1.5px dashed var(--preview-border);
  }
  .contact-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .contact-meta {
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  /* ============ Responsive ============ */
  @media (max-width: 768px) {
    .hero {
      padding-top: 48px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 26px;
      justify-items: center;
      text-align: center;
    }
    .hero-copy {
      text-align: center;
    }
    .hero-actions {
      justify-content: center;
    }
    .flagship-card .card-link,
    .supporting-grid {
      grid-template-columns: 1fr;
    }
    .flagship-media {
      min-height: 0;
      border-right: none;
      border-bottom: 1.5px dashed var(--preview-border);
    }
    .products-grid,
    .service-grid,
    .exp-grid {
      grid-template-columns: 1fr;
    }
    .impact-card {
