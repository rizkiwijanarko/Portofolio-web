---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const resume = (await getCollection('resume'))[0]?.data;
const base = import.meta.env.BASE_URL;
const photo = base + 'assets/my_photo.jpg';
---

<Layout title="Contact" active="contact" description="Contact Kharisma Rizki Wijanarko — AI Engineer based in Jombang, East Java, Indonesia.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1 class="page-title">Let's talk.</h1>
      <p class="page-sub">Open to AI engineering roles, freelance work, and interesting collaborations.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <div class="contact-photo">
          <img src={photo} alt="Portrait of Kharisma Rizki Wijanarko" width="816" height="1118" />
        </div>
        <div class="contact-copy">
          <h2 class="contact-name">{resume?.contact.name}</h2>
          <p class="contact-loc">{resume?.contact.location} &middot; WIB (UTC+7)</p>
          <p class="contact-intro">
            I build production-ready AI systems and AI-native SaaS — from RAG pipelines and
            multi-agent workflows to computer vision. If you have a problem that needs
            dependable AI, I'd love to hear about it.
          </p>
          <div class="contact-list">
            <a class="contact-item" href={'mailto:' + resume?.contact.email}>
              <span class="contact-label">Email</span>
              <span class="contact-value">{resume?.contact.email}</span>
            </a>
            <a class="contact-item" href={resume?.contact.github} target="_blank" rel="noopener">
              <span class="contact-label">GitHub</span>
              <span class="contact-value">github.com/rizkiwijanarko</span>
            </a>
            <a class="contact-item" href={resume?.contact.linkedin} target="_blank" rel="noopener">
              <span class="contact-label">LinkedIn</span>
              <span class="contact-value">linkedin.com/in/rizki-wijanarko</span>
            </a>
            <a class="contact-item" href={base + 'Kharisma_Rizki_Wijanarko_CV.pdf'} download>
              <span class="contact-label">Resume</span>
              <span class="contact-value">Download CV (PDF)</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding: 72px 0 8px;
  }
  .page-title {
    font-size: clamp(2.2rem, 4.6vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .page-sub {
    color: var(--ink-soft);
    max-width: 56ch;
    margin-top: 12px;
    font-size: 1.05rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 48px;
    max-width: 820px;
    margin: 56px auto 0;
    align-items: start;
  }
  .contact-photo {
    position: relative;
  }
  .contact-photo::before {
    content: '';
    position: absolute;
    inset: -10px;
    z-index: -1;
    border: 2px dashed #e6cfb4;
    border-radius: 30px;
    transform: rotate(-2deg);
  }
  .contact-photo img {
    width: 260px;
    height: auto;
    border-radius: 22px;
    border: 4px solid #fff;
    box-shadow: var(--shadow-card);
  }
  .contact-name {
    font-size: 1.6rem;
    font-weight: 800;
  }
  .contact-loc {
    color: var(--ink-faint);
    font-size: 0.9rem;
    margin: 4px 0 16px;
  }
  .contact-intro {
    color: var(--ink-soft);
    margin-bottom: 28px;
  }
  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .contact-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    transition: background-color 150ms ease;
    color: inherit;
  }
  .contact-item:hover {
    background: var(--chip-bg);
    text-decoration: none;
  }
  .contact-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .contact-value {
    font-weight: 600;
    color: var(--ink);
  }
  .contact-item:hover .contact-value {
    color: var(--accent-deep);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 36px;
      justify-items: center;
      text-align: center;
    }
    .contact-item {
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
  }
</style>
