---
interface Props {
  active?: string;
}
const { active } = Astro.props;
const links = [
  { href: '/projects/', label: 'Projects', key: 'projects' },
  { href: '/experience/', label: 'Experience', key: 'experience' },
  { href: '/resume/', label: 'Résumé', key: 'resume' },
];
const base = import.meta.env.BASE_URL;
const contactHref = base + '#contact';
---

<header class="site-header">
  <div class="wrap nav-wrap">
    <a class="brand" href={base}>Rizki<span class="brand-dot">.</span></a>
    <nav class="nav" aria-label="Primary">
      {links.map((l) => (
        <a
          href={base + l.href.slice(1)}
          class:list={[{ active: active === l.key }]}
          aria-current={active === l.key ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
      <a class="nav-cta" href={contactHref}>Describe your product</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-surface);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px 0;
    flex-wrap: wrap;
  }
  .brand {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    display: inline-flex;
    align-items: baseline;
    gap: 1px;
  }
  .brand-dot {
    color: var(--accent);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .nav a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--ink-soft);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 8px 13px;
    border-radius: var(--radius-pill);
    transition: background-color 150ms ease, color 150ms ease;
  }
  .nav a:hover {
    background: var(--chip-bg);
    color: var(--ink);
    text-decoration: none;
  }
  .nav a.active {
    background: var(--accent-tint);
    color: var(--accent-deep);
  }
  .nav .nav-cta {
    background: var(--accent);
    color: var(--on-accent);
    margin-left: 6px;
  }
  .nav .nav-cta:hover {
    background: var(--accent-deep);
    color: var(--on-accent);
  }
  @media (max-width: 768px) {
    .nav-wrap {
      justify-content: center;
    }
  }
</style>
